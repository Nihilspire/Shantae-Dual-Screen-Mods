@@ -26,6 +26,85 @@ namespace {
 
 using namespace gambatte;
 
+/* Dual: NO SPRITE LIMIT. The hardware draws at most 10 sprites per line (the first 10 in OAM order); games that put
+ * more on a line lose the rest, and many rotate OAM so a different set drops each frame (flicker). With gbx_nolimit
+ * set, every line records all its sprites when mode 3 starts, and gbx_draw_overflow() draws the ones past the 10th
+ * into the finished frame: under the line's own sprites (they have lower OAM priority), with CGB BG priority. PPU
+ * timing is untouched, so games behave exactly as before. CGB mode only. */
+extern "C" { int gbx_nolimit = 0; }
+namespace {
+struct GbxLine { unsigned char n, lcdc, scx, scy, wx, win, done, pad; unsigned char oam[40][4]; };
+GbxLine gbxLines[144];
+PPUPriv *gbxPpu = 0;
+
+void gbxRecordLine(PPUPriv const &p, unsigned ly) {
+	if (ly >= 144) return;
+	GbxLine &L = gbxLines[ly];
+	unsigned char const *const oam = p.spriteMapper.oamram();
+	unsigned const h = (p.lcdc & 4) ? 16 : 8, n0 = 0;
+	unsigned n = n0;
+	for (unsigned i = 0; i < 40; ++i) {
+		unsigned const y = oam[i * 4];
+		if (ly + 16 >= y && ly + 16 < y + h) { std::memcpy(L.oam[n], oam + i * 4, 4); ++n; }
+	}
+	L.n = n; L.lcdc = p.lcdc; L.scx = p.scx; L.scy = p.scy; L.wx = p.wx;
+	L.win = (p.lcdc & 0x20) && p.weMaster && p.wx < 167;
+	L.done = 1;
+}
