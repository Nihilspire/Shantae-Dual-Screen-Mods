+   /* Dual: side-effect free CPU-view access (current ROM/SRAM/WRAM/VRAM banks). */
+   unsigned peek(unsigned a) const {
+      a &= 0xFFFF;
+      if (a >= 0xFE00) return ioamhram_[a - 0xFE00];
+      if (a >= 0xE000) a -= 0x2000;
+      if (a >= 0xD000) return cart_.wramdata(1)[a - 0xD000];
+      if (a >= 0xC000) return cart_.wramdata(0)[a - 0xC000];
+      if (a >= 0xA000) return cart_.rsrambankptr()[a];
+      if (a >= 0x8000) return cart_.vrambankptr()[a];
+      const unsigned char *p = cart_.rmem(a >> 12); return p ? p[a] : 0xFF;
+   }
+   void poke(unsigned a, unsigned v) {
+      a &= 0xFFFF;
+      if (a >= 0xFE00) ioamhram_[a - 0xFE00] = v;
+      else if (a >= 0xD000 && a < 0xE000) cart_.wramdata(1)[a - 0xD000] = v;
+      else if (a >= 0xC000 && a < 0xD000) cart_.wramdata(0)[a - 0xC000] = v;
+      else if (a >= 0xA000 && a < 0xC000) cart_.wsrambankptr()[a] = v;
+      else if (a >= 0x8000 && a < 0xA000) cart_.vrambankptr()[a] = v;
+   }
